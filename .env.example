# Copy this file to .env and fill in local values. Never commit .env.
# Phase 5 qualitative analysis. Keep the real key only in the ignored .env file.
GROQ_API_KEY=
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=45
RUN_GROQ_INTEGRATION_TESTS=false
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=tcs_financial_forecasting
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
RAG_CHUNK_SIZE=650
RAG_CHUNK_OVERLAP=100
RAG_SIMILARITY_THRESHOLD=0.25
RAG_RETRIEVAL_TOP_K=5
MODEL_CACHE_DIR=.cache/sentence-transformers
DOCUMENT_REPORTS_DIR=data/financial_reports
DOCUMENT_TRANSCRIPTS_DIR=data/earnings_transcripts
VECTORSTORE_DIR=vectorstore
